# dependencies
node_modules/

# build output
/dist
/build
/.vite
sa-job-agent-suite/client/dist
sa-job-agent-suite/client/build
sa-job-agent-suite/release/

# vite transient config artifacts (esbuild-transpiled config, normally auto-removed)
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# local env files (the committed .env.example templates stay tracked)
.env
.env.*
!.env.example

# credential and key stores, at any depth.
# When run from source the app writes provider API keys to keys.json next to
# db.json (see server/src/db/helper.js). Keep every spelling of that out of git.
keys.json
keys.*.json
*.keys.json
keys.json.*
*.pem
*.key
*.p12
*.pfx

# local user data - never commit these
# (profile, CV text, jobs, answer bank, browser login state, generated documents)
sa-job-agent-suite/db.json
sa-job-agent-suite/db.backup.json
sa-job-agent-suite/browser-profile/
sa-job-agent-suite/generated-docs/
sa-job-agent-suite/supporting-docs/

# editor
.vscode/
.idea/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db